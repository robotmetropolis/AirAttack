# Credenciales OAuth2 OpenSky (gratis en https://opensky-network.org/my-opensky)
# Copialas desde "Account → API Client".
# Sin esto, el proxy funciona en modo anónimo (400 créditos/día).

OPENSKY_CLIENT_ID=tu-email-api-client
OPENSKY_CLIENT_SECRET=tu-secret-largo-aqui

# Puerto del proxy (default 8787)
PORT=8787
